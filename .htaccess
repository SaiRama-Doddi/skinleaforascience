# Leafora Life Sciences SPA & Node.js Routing Configuration for Hostinger
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files, directories, and uploads directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>
