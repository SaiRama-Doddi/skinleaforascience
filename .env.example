# Copy to .env (never commit .env). On Hostinger, set these in hPanel → Node.js → Environment Variables.

# Server Configuration
PORT=5000
NODE_ENV=production
# Number of reverse proxies in front of Node (Hostinger = 1). Needed for correct client IPs / rate limiting.
TRUST_PROXY_HOPS=1

# MySQL Database Configuration (use localhost / 127.0.0.1 on the Hostinger server)
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# Admin login (OTP is emailed to this address; extra admins can be added in admin_users)
ADMIN_EMAIL=owner@example.com

# SMTP (Gmail: use an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password

# CORS: comma-separated list of extra origins allowed to call the API.
# Leave empty if the frontend is served by this same server.
CLIENT_URL=

# Razorpay (Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
